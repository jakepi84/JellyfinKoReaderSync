<Project>
    <PropertyGroup>
        <!-- Single source of truth for the plugin version.

             Jellyfin reports PluginInfo.Version from the DLL *assembly* version (not
             from manifest.json or meta.json) and the web UI builds the plugin icon URL
             as "/Plugins/<Id>/<PluginInfo.Version>/Image". If the assembly version does
             not equal the plugin version recorded in manifest.json, that URL 404s and
             the plugin shows a blank tile with the wrong version.

             The release scripts read the Version element below and refuse to publish when
             the built assembly version disagrees with it, so bump this value only. -->
        <Version>2.0.4.1</Version>
        <AssemblyVersion>$(Version)</AssemblyVersion>
        <FileVersion>$(Version)</FileVersion>
    </PropertyGroup>
</Project>
